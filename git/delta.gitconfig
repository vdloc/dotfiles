# delta: syntax-highlighted, side-by-side diffs (Catppuccin Mocha).
# Included from ~/.gitconfig via [include] path.
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	side-by-side = true
	syntax-theme = Catppuccin Mocha
[merge]
	conflictStyle = zdiff3
[diff]
	colorMoved = default
